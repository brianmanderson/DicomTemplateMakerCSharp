<Project>

  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Lets WPF projects build (not run) on Linux and macOS, e.g. for CI and tooling. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Company>DicomTemplateMaker contributors</Company>
    <Product>DicomTemplateMaker</Product>
    <VersionPrefix>1.1.0</VersionPrefix>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    dotnet publish (the release) embeds symbols in each assembly instead of shipping .pdb files, so logged
    exception stack traces keep their line numbers. Set for every project because the GUI's references are
    rebuilt by its publish and would otherwise copy their own .pdb files. A normal build keeps .pdb files.
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
