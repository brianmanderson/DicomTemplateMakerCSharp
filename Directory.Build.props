<Project>

  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Lets WPF projects build (not run) on Linux and macOS, e.g. for CI and tooling. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Company>DicomTemplateMaker contributors</Company>
    <Product>DicomTemplateMaker</Product>
    <VersionPrefix>1.1.0</VersionPrefix>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
