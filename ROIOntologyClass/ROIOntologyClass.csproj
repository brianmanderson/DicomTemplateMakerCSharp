<Project Sdk="Microsoft.NET.Sdk">

  <!-- ROI, ontology-code and template-folder model. Platform-neutral: no WPF types. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ROIOntologyClass</RootNamespace>
    <AssemblyName>ROIOntologyClass</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <!-- AtomicFile and the template-file checks are shared with the template engine and its tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DicomTemplateCore" />
    <InternalsVisibleTo Include="DicomTemplateCore.Tests" />
  </ItemGroup>

</Project>
