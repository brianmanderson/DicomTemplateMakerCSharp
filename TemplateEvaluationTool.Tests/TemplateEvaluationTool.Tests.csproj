<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TemplateEvaluationTool\TemplateEvaluationTool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scripted HTTP handler and clock of the TemplateSync tests: write-airtable is tested without any network. -->
    <Compile Include="..\TemplateSync.Tests\Fakes\FakeHttpHandler.cs" Link="Fakes\FakeHttpHandler.cs" />
    <Compile Include="..\TemplateSync.Tests\Fakes\AirtableJson.cs" Link="Fakes\AirtableJson.cs" />
    <Compile Include="..\TemplateSync.Tests\Fakes\FakeClock.cs" Link="Fakes\FakeClock.cs" />
  </ItemGroup>

</Project>
