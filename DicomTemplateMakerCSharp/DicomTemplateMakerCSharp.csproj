<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console runner: applies every template under a folder to the DICOM folders listed in its Paths.txt. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DicomTemplateCore\DicomTemplateCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\DicomTemplateMakerGUI\template_RS.dcm" Link="template_RS.dcm" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
