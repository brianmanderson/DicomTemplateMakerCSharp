<Window x:Class="DicomTemplateMakerGUI.Windows.AddAirTableTemplate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DicomTemplateMakerGUI.Windows"
        mc:Ignorable="d"
        Title="Add an Airtable table" Height="300" Width="500" WindowStartupLocation="CenterOwner">
    <Grid>
        <Button x:Name="AddAirTableButton" Content="Test connection and add" HorizontalAlignment="Left" Margin="10,7,0,0" IsEnabled="False" VerticalAlignment="Top" Width="464" Height="36" Click="AddAirTableButton_Click"/>
        <Label Content="Table Name" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top" Height="26" Width="135"/>
        <TextBox x:Name="TableName_TextBox" TextChanged="AddAirTableTextUpdate" HorizontalAlignment="Left" Height="24" Margin="150,50,0,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" Width="324"/>
        <Label Content="Personal Access Token" HorizontalAlignment="Left" Margin="10,80,0,0" VerticalAlignment="Top" Height="26" Width="135"/>
        <PasswordBox x:Name="API_PasswordBox" PasswordChanged="AddAirTablePasswordUpdate" HorizontalAlignment="Left" Height="24" Margin="150,80,0,0" VerticalAlignment="Top" Width="324" ToolTip="Create one at airtable.com/create/tokens with the data.records:read and data.records:write scopes for this base."/>
        <Label Content="Base Id" HorizontalAlignment="Left" Margin="10,110,0,0" VerticalAlignment="Top" Height="26" Width="135"/>
        <TextBox x:Name="Base_TextBox" TextChanged="AddAirTableTextUpdate" HorizontalAlignment="Left" Height="24" Margin="150,110,0,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" Width="324" ToolTip="Starts with app; it is the part of the base URL after airtable.com/."/>
        <Label Content="Table Id" HorizontalAlignment="Left" Margin="10,140,0,0" VerticalAlignment="Top" Height="26" Width="135"/>
        <TextBox x:Name="Table_TextBox" TextChanged="AddAirTableTextUpdate" HorizontalAlignment="Left" Height="24" Margin="150,140,0,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" Width="324" ToolTip="Starts with tbl; it follows the base id in the table URL."/>
        <TextBlock x:Name="Validation_Text" Foreground="DarkRed" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="12,175,0,0" VerticalAlignment="Top" Width="462" Height="75"/>
    </Grid>
</Window>
