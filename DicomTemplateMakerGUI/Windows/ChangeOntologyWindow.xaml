<Window x:Class="DicomTemplateMakerGUI.Windows.ChangeOntologyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DicomTemplateMakerGUI.Windows"
        mc:Ignorable="d"
        Title="Change ontology scheme" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <StackPanel x:Name="RootPanel" Margin="12">
        <TextBlock TextWrapping="Wrap"
                   Text="Converts the ontology codes of the ROIs of every template in the main window's list, and of the ontology library, from one coding scheme to the other, using the FMA to SNOMED CT table shipped with the program. Codes without an equivalent are left as they are. You are asked to confirm, with the numbers, before anything changes."/>
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="Convert _from" Target="{Binding ElementName=From_ComboBox}" Padding="0,0,0,3"/>
                <ComboBox x:Name="From_ComboBox" Height="30" VerticalContentAlignment="Center" SelectionChanged="ToFromComboBox_SelectionChanged"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="to" VerticalAlignment="Bottom" Margin="12,0,12,6"/>
            <StackPanel Grid.Column="2">
                <Label Content="Convert _to" Target="{Binding ElementName=To_ComboBox}" Padding="0,0,0,3"/>
                <ComboBox x:Name="To_ComboBox" Height="30" VerticalContentAlignment="Center" SelectionChanged="ToFromComboBox_SelectionChanged"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ConverterButton" Content="Convert…" Width="100" Height="30" IsEnabled="False" Click="ConverterButton_Click"/>
            <Button x:Name="CloseButton" Content="Close" Width="90" Height="30" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
