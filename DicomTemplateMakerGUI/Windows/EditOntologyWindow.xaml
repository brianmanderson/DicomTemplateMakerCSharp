<Window x:Class="DicomTemplateMakerGUI.Windows.EditOntologyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DicomTemplateMakerGUI.Windows"
        mc:Ignorable="d"
        Title="Edit ontologies" Height="660" Width="860" MinHeight="440" MinWidth="780"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="NoteText" TextWrapping="Wrap" Foreground="#FF5A5A5A"/>
            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Add from RT Structure file…" Width="220" Height="30" Click="AddOntologyFromRT_Click"/>
                <Button x:Name="FMA_SNOMED_Button" Content="Change ontology scheme…" Width="220" Height="30" Margin="8,0,0,0" Click="FMA_SNOMED_Button_Click"/>
            </WrapPanel>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Add an entry" Margin="0,10,0,0" Padding="6">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,8,0">
                        <Label Content="Common _name" Target="{Binding ElementName=PreferredNameTextBox}" Padding="0,0,0,3"/>
                        <TextBox x:Name="PreferredNameTextBox" Width="250" Height="30" VerticalContentAlignment="Center" TextChanged="UpdateText"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <Label Content="_Code value (required)" Target="{Binding ElementName=CodeValue_TextBox}" Padding="0,0,0,3"/>
                        <TextBox x:Name="CodeValue_TextBox" Width="170" Height="30" VerticalContentAlignment="Center" TextChanged="UpdateText"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <Label Content="Coding _scheme" Target="{Binding ElementName=CodeScheme_TextBox}" Padding="0,0,0,3"/>
                        <TextBox x:Name="CodeScheme_TextBox" Width="150" Height="30" VerticalContentAlignment="Center" TextChanged="UpdateText"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <Button x:Name="AddOntology_Button" Content="Add to library" Width="130" Height="30" IsEnabled="False" Click="AddOntology_Click"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock x:Name="EntryStatusText" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </GroupBox>

        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,4">
            <Label Content="Search by name, code or scheme:" Target="{Binding ElementName=SearchBox_TextBox}" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox_TextBox" Width="220" Height="30" VerticalContentAlignment="Center" TextChanged="SearchTextUpdate"/>
        </WrapPanel>

        <ContentControl Grid.Row="3" x:Name="OntologyHeaderHost" Focusable="False"/>
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="OntologyStackPanel"/>
        </ScrollViewer>

        <DockPanel Grid.Row="5" Margin="0,10,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="Save_Button" Content="Save" Width="90" Height="30" Margin="8,0,0,0" Click="Save_Changes_Click"/>
                <Button x:Name="SaveAndExit_Button" Content="Save and close" Width="120" Height="30" Margin="8,0,0,0" Click="Save_and_Exit_Click"/>
                <Button x:Name="Close_Button" Content="Close" Width="90" Height="30" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
            <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
