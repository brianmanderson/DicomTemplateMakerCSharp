<Window x:Class="DicomTemplateMakerGUI.Windows.RenameTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DicomTemplateMakerGUI.Windows"
        mc:Ignorable="d"
        Title="Rename template" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown"
        FocusManager.FocusedElement="{Binding ElementName=NewName_TextBox}">
    <StackPanel Margin="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="Current name" Padding="0,0,0,3"/>
            <TextBox Grid.Row="1" Grid.Column="0" x:Name="PreviousName_Textbox" Height="26" VerticalContentAlignment="Center" IsReadOnly="True"/>
            <Label Grid.Row="0" Grid.Column="2" Content="_New name" Target="{Binding ElementName=NewName_TextBox}" Padding="0,0,0,3"/>
            <TextBox Grid.Row="1" Grid.Column="2" x:Name="NewName_TextBox" Height="26" VerticalContentAlignment="Center" TextChanged="NewName_TextBox_TextChanged"/>
        </Grid>
        <TextBlock x:Name="Status_Label" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="Consequences_Text" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="Rename_Button" Content="Rename" Width="90" Height="28" IsEnabled="False" IsDefault="True" Click="Rename_Button_Click"/>
            <Button x:Name="Cancel_Button" Content="Cancel" Width="90" Height="28" Margin="8,0,0,0" Click="Cancel_Button_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
