<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- System.Windows.Forms.ColorDialog is used for colour picking. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DicomTemplateMakerGUI</RootNamespace>
    <AssemblyName>DicomTemplateMakerGUI</AssemblyName>
    <AssemblyTitle>DICOM RT Template Maker</AssemblyTitle>
    <!-- Old NuGet packages folders and token files must never be picked up by globbing. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);packages\**;AirTables\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DicomTemplateCore\DicomTemplateCore.csproj" />
    <ProjectReference Include="..\DicomTemplateMaker.Presentation\DicomTemplateMaker.Presentation.csproj" />
    <ProjectReference Include="..\ROIOntologyClass\ROIOntologyClass.csproj" />
    <ProjectReference Include="..\TemplateSync\TemplateSync.csproj" />
  </ItemGroup>

  <!-- Logging to a daily rolling file in %LOCALAPPDATA%\DicomTemplateMaker\logs (set up in App.OnStartup). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!-- Images compiled into the assembly (pack URIs used by the About window). -->
  <ItemGroup>
    <Resource Include="Windows\*.JPG" />
  </ItemGroup>

  <!--
    Files the program reads from its own folder at run time. ExcludeFromSingleFile keeps them next to the
    exe in the single-file release; bundled inside it they could not be opened by path.
  -->
  <ItemGroup>
    <Content Include="FMA_SNOMEDCT_Key.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="SmallCT\*.dcm" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Structure Template.xml" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="template_RS.dcm" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\TemplateSnapshots\TG263.json" Condition="Exists('..\TemplateSnapshots\TG263.json')" Link="TemplateSnapshots\TG263.json" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
