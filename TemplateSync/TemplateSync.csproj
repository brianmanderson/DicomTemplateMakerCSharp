<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral template synchronisation library (Airtable, cache, shared snapshot). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TemplateSync</RootNamespace>
    <AssemblyName>TemplateSync</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TemplateSync.Tests" />
  </ItemGroup>

</Project>
